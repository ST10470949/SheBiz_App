rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isAuthenticated() && (request.auth.token.email_verified == true || resource.data.emailVerified == true);
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId);

      // Sub-collections: Applications
      match /applications/{applicationId} {
        allow read, write: if isOwner(userId);
      }

      // Sub-collections: Saved Opportunities
      match /savedOpportunities/{oppId} {
        allow read, write: if isOwner(userId);
      }

      // Sub-collections: Mentorships
      match /mentorships/{mentorshipId} {
        allow read, write: if isOwner(userId);
      }

      // Sub-collections: Business Products
      match /products/{productId} {
        allow read, write: if isOwner(userId);
      }

      // Sub-collections: Business Sales
      match /sales/{saleId} {
        allow read, write: if isOwner(userId);
      }

      // Sub-collections: Business Expenses
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }

      // Sub-collections: Customers
      match /customers/{customerId} {
        allow read, write: if isOwner(userId);
      }

      // Sub-collections: Course Progress
      match /courseProgress/{courseId} {
        allow read, write: if isOwner(userId);
      }

      // Sub-collections: Notifications
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }

      // Sub-collections: AI Chats
      match /aiChats/{chatId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public / Read-Only Collections for Authenticated Users
    match /opportunities/{opportunityId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin managed
    }

    match /mentors/{mentorId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin managed
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin managed
    }

    // Chat between User and Mentor
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Email Verifications (restricted, written by Cloud Function / admin)
    match /emailVerifications/{userId} {
      allow read, write: if false;
    }

    // Support Inquiries
    match /support/{supportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }
  }
}
